# ===================================================
# CitySwap Root Environment Variables Configuration
# ===================================================

PROJECT_NAME=CitySwap Backend
PROJECT_VERSION=1.0.0
ENVIRONMENT=development

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://your_user:your_secure_password@ep-your-project-id.region.neon.tech/neondb?sslmode=require

# Security
SECRET_KEY=replace_with_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

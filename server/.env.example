PROJECT_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Host & CORS Settings
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:npg_dmh4HkC9XAob@ep-lively-firefly-axvz95yn-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

